<Window x:Class="Now_Playing.Options.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Now_Playing.Options"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        WindowState="Maximized"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Title="Settings">
    <Window.Background>
        <SolidColorBrush Color="Black" Opacity="0.3" />
    </Window.Background>
    <Window.Resources>
        <Style x:Key="SettingsTitleTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <FontFamily x:Key="SymbolThemeFontFamily">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
    </Window.Resources>    
    
    <StackPanel Margin="4,0">
        <TextBlock Text="Appearance &amp; behavior" Style="{StaticResource SettingsTitleTextBlockStyle}" />
        <Expander Margin="0,0,0,4">
            <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="&#xE90B;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="24" Grid.RowSpan="2" />

                    <TextBlock Text="Automatically toggle lyrics" Grid.Column="2" />
                    <TextBlock Text="When lyrics are available, show them. Otherwise, hide them." Foreground="{StaticResource TextFillColorSecondaryBrush}" Grid.Column="2" Grid.Row="1" />
                </Grid>
            </Expander.Header>
            <TextBlock Text="Content" />
        </Expander>
    </StackPanel>
    
